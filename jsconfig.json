{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@src/*": ["src/*"],
      "@styles/*": ["src/styles/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@images/*": ["src/public/images/*"],
      "@icons/*": ["src/public/icons/*"]
    },
    "ignoreDeprecations": "6.0"
  }
}
